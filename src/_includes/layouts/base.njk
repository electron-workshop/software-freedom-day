<!DOCTYPE html>
<html lang="en">
<head>
  {% set pageTitle = title or site.meta.title %}
  {% set pageDesc = description or site.meta.description %}
  {% set pageUrl = site.url + (page.url or "/") %}

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:type" content="website">
  {% if preview_image %}<meta property="og:image" content="{{ preview_image }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  {% if preview_image %}<meta name="twitter:image" content="{{ preview_image }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap" rel="stylesheet">
  <link href="/assets/css/style.css" rel="stylesheet">
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>

  <div class="sheet">
    <div class="rail rail--top">
      <span>{{ site.name }} &middot; {{ site.date }}</span>
      <nav aria-label="Site">
        <a href="/">Locations</a>
        <a href="{{ site.organise.url }}">Host your own</a>
        <a href="{{ site.archive.url }}">{{ site.archive.linkText }}</a>
      </nav>
    </div>
  </div>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="sheet">
    <div class="rail rail--bottom">
      <span>{{ site.contact.values }}</span>
      <span>
        <a href="{{ site.contact.codeOfConductUrl }}">{{ site.contact.codeOfConductText }}</a>
        &middot;
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </span>
    </div>
  </footer>

</body>
</html>
