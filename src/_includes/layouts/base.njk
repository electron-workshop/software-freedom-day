<!DOCTYPE html>
<html lang="en">
<head>
  {% set pageTitle = title or site.meta.title %}
  {% set pageDesc = description or site.meta.description %}
  {# Canonical always points at the live site, so previews never compete with
     it. Share links point at whichever build is being viewed, so the card
     works when you send a preview link around. #}
  {% set pageUrl = site.url + (page.url or "/") %}
  {% set pageShareUrl = global.shareUrl + (page.url or "/") %}
  {% set pageImage = preview_image or (global.shareUrl + site.previewImage.path) %}

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ pageUrl }}">
  {# Pages that only make sense as the end of a journey, so they should not
     turn up in search results on their own. #}
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageShareUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:width" content="{{ site.previewImage.width }}">
  <meta property="og:image:height" content="{{ site.previewImage.height }}">
  <meta property="og:image:alt" content="{{ site.previewImage.alt }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ pageImage }}">
  <meta name="twitter:image:alt" content="{{ site.previewImage.alt }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap" rel="stylesheet">
  <link href="/assets/css/style.css" rel="stylesheet">
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>

  <div class="sheet">
    <div class="rail rail--top">
      {# Logo only, linking home. The artwork itself reads "Software Freedom
         Day", so the alt text carries that name for anyone who cannot see it. #}
      <a class="brand" href="/">
        <img class="brand__logo"
             src="/assets/images/sfdlogo_622wide.png"
             alt="Software Freedom Day, home page"
             width="622" height="160">
      </a>

      <span class="rail__date">{{ site.date }}</span>

      {# The button is hidden until the script marks the menu ready, so with
         no JavaScript the links simply render as an ordinary list rather
         than sitting behind a button that cannot open. #}
      <div class="menu" data-menu>
        <button class="menu__btn" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="menu__bars" aria-hidden="true"></span>
          <span class="menu__word">Menu</span>
        </button>

        <nav class="menu__panel" id="site-nav" aria-label="Site">
          {# Lands on the locations list rather than the top of the page, so
             the link goes where its name says. Same anchor the scroll cue
             uses, and the smooth scrolling is inherited from html. #}
          <a href="/#events">Events &amp; Locations</a>
          {# Only worth offering while at least one location actually wants
             volunteers, otherwise the page has nothing to choose from. #}
          {% set wantsHelp = false %}
          {% for event in events %}{% if event.volunteer and event.volunteer.open %}{% set wantsHelp = true %}{% endif %}{% endfor %}
          {% if wantsHelp %}<a href="/volunteer/">Volunteer</a>{% endif %}
          <a href="{{ site.organise.url }}">Host your own</a>
          <a href="{{ site.archive.url }}" target="_blank" rel="noopener noreferrer">
            {{ site.archive.linkText }}
            <svg class="ext" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M14 4h6v6"/>
              <path d="M20 4 11 13"/>
              <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
            </svg>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </nav>
      </div>
    </div>
  </div>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="sheet">
    {% if site.organisers and site.organisers.items | length %}
      <div class="orgs">
        <span class="orgs__lab">{{ site.organisers.label }}</span>
        <ul class="orgs__list">
          {% for org in site.organisers.items %}
            <li>
              {% if org.url %}
                <a class="orgs__item" href="{{ org.url }}" target="_blank" rel="noopener noreferrer">
                  <img src="{{ org.src }}" alt="{{ org.alt }}" loading="lazy" decoding="async">
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              {% else %}
                <span class="orgs__item">
                  <img src="{{ org.src }}" alt="{{ org.alt }}" loading="lazy" decoding="async">
                </span>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <div class="rail rail--bottom">
      {# The address is written out rather than linked, so the page does not hand
         a plain mailto to every scraper. The "email us" buttons on the pages
         themselves still open a real mail client. #}
      <div class="foot-col foot-col--contact">
        <span class="foot-line">
          <svg class="foot-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v.01L12 12l8-5.99V6H4zm16 12V8.24l-7.4 5.55a1 1 0 0 1-1.2 0L4 8.24V18h16z"/>
          </svg>
          {{ site.contact.emailDisplay }}
        </span>

        <a class="foot-line foot-line--link"
           href="{{ site.contact.github.url }}"
           target="_blank" rel="noopener noreferrer">
          <svg class="foot-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.5 18.3 4.8 18.3 4.8c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/>
          </svg>
          {{ site.contact.github.label }}
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>

      <div class="foot-col foot-col--values">
        <span>{{ site.contact.values }}</span>
        {# Code of conduct has its own page coming. Until site.contact.codeOfConductUrl
           is filled in, show nothing rather than a link that goes nowhere. #}
        {% if site.contact.codeOfConductUrl %}
          <a href="{{ site.contact.codeOfConductUrl }}">{{ site.contact.codeOfConductText }}</a>
        {% endif %}
      </div>
    </div>
  </footer>

  <script>
    // Progressive enhancement: the markup is a plain list of links until this
    // runs. Adding is-ready is what lets the stylesheet collapse it behind the
    // button on small screens.
    document.querySelectorAll("[data-menu]").forEach(function (menu) {
      var btn = menu.querySelector(".menu__btn");
      if (!btn) return;
      menu.classList.add("is-ready");

      function setOpen(open) {
        menu.toggleAttribute("data-open", open);
        btn.setAttribute("aria-expanded", String(open));
      }

      btn.addEventListener("click", function () {
        setOpen(!menu.hasAttribute("data-open"));
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && menu.hasAttribute("data-open")) {
          setOpen(false);
          btn.focus();
        }
      });

      document.addEventListener("click", function (e) {
        if (!menu.contains(e.target)) setOpen(false);
      });
    });
  </script>

</body>
</html>
