<!DOCTYPE html>
<html lang="en">
<head>
  {% set pageTitle = title or site.meta.title %}
  {% set pageDesc = description or site.meta.description %}
  {% set pageUrl = site.url + (page.url or "/") %}

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:type" content="website">
  {% if preview_image %}<meta property="og:image" content="{{ preview_image }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  {% if preview_image %}<meta name="twitter:image" content="{{ preview_image }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap" rel="stylesheet">
  <link href="/assets/css/style.css" rel="stylesheet">
</head>
<body>

  <a class="skip-link" href="#main">Skip to content</a>

  <div class="sheet">
    <div class="rail rail--top">
      {# Logo only, linking home. The artwork itself reads "Software Freedom
         Day", so the alt text carries that name for anyone who cannot see it. #}
      <a class="brand" href="/">
        <img class="brand__logo"
             src="/assets/images/sfdlogo_622wide.png"
             alt="Software Freedom Day, home page"
             width="622" height="160">
      </a>

      <span class="rail__date">{{ site.date }}</span>

      <nav aria-label="Site">
        <a href="/">Events &amp; Locations</a>
        <a href="{{ site.organise.url }}">Host your own</a>
        <a href="{{ site.archive.url }}" target="_blank" rel="noopener noreferrer">
          {{ site.archive.linkText }}
          <svg class="ext" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14 4h6v6"/>
            <path d="M20 4 11 13"/>
            <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
          </svg>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </nav>
    </div>
  </div>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="sheet">
    <div class="rail rail--bottom">
      <span>{{ site.contact.values }}</span>
      <span>
        {# Code of conduct has its own page coming. Until site.contact.codeOfConductUrl
           is filled in, show nothing rather than a link that goes nowhere. #}
        {% if site.contact.codeOfConductUrl %}
          <a href="{{ site.contact.codeOfConductUrl }}">{{ site.contact.codeOfConductText }}</a>
          &middot;
        {% endif %}
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </span>
    </div>
  </footer>

</body>
</html>
