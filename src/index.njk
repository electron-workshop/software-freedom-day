---
layout: base.njk
permalink: "/"
---

{% set angles = ["a1", "a2", "a3", "a4", "a5"] %}

{#
  IMAGE SLOTS
  Anywhere you see a <div class="ph"> ... </div>, that is a placeholder.
  To use a real photo, delete the whole .ph block and put an <img> in
  its place, keeping the surrounding .st--photo sticker:

      <div class="st st--photo a3 col-4">
        <img src="/assets/images/photos/your-photo.jpg" alt="Describe the photo">
      </div>

  Add a caption by wrapping it in <figure> ... <figcaption>.
  Photos live in src/assets/images/photos/.
#}

<div class="sheet">

  {# ===================== HERO =====================
     Both columns are stacks, so the hero sits at its own natural
     height instead of stretching to match the column beside it.
     That leaves room for a photo underneath it. #}
  <div class="grid">
    <div class="stack col-8">
      <div class="st st--dark st--peel a1 hero">
        <span class="lab">{{ site.date }}</span>
        <h1>Software<br>Freedom Day</h1>
        <p>{{ site.intro }}</p>
      </div>

      {# IMAGE SLOTS #}
      <div class="grid">
        <div class="st st--photo a3 col-8">
          <img src="/assets/images/photos/talk-2025.jpg"
               alt="A room of people watching a talk at Software Freedom Day 2025. The slide behind the speaker reads Freedom Also Means Sharing."
               width="1440" height="710" loading="lazy" decoding="async">
        </div>

        <div class="st st--photo a5 col-4">
          <img src="/assets/images/photos/laptops-balloons.jpg"
               alt="Four volunteers sitting together holding laptops, with Software Freedom Day balloons around them."
               width="370" height="450" loading="lazy" decoding="async">
        </div>
      </div>
    </div>

    <div class="stack col-4">
      <div class="st st--green st--peel a4">
        <span class="lab">{{ site.beginners.label }}</span>
        <p class="punch">{{ site.beginners.heading }}</p>
        <p class="st__body" style="margin-top:8px">{{ site.beginners.body }}</p>
      </div>

      <div class="st st--yellow st--circle a2">
        <div class="mega">{{ site.cost.value }}</div>
        <p class="st__body" style="margin-top:6px">{{ site.cost.body }}</p>
      </div>
    </div>
  </div>

  {# ===================== LOCATIONS ===================== #}
  <div class="locs-hd" id="events">
    <h2>Where it's on</h2>
    <span class="rule"></span>
    <span class="count">
      {{ events | length }} confirmed
    </span>
  </div>

  {% for event in events %}
    {% set status = event.status or "confirmed" %}
    <section class="loc loc--{{ status }}" id="{{ event.id }}">
      <span class="loc__tab">
        Location {% if loop.index < 10 %}0{% endif %}{{ loop.index }}
        {%- if event.region %} &middot; {{ event.region }}{% endif %}
      </span>

      <div class="grid">
        <div class="st st--green st--peel a3 col-12 loc__head">
          <div>
            <span class="lab">{{ status | capitalize }}</span>
            <h2>{{ event.venue }}{% if event.city %}, {{ event.city }}{% endif %}</h2>
            {% if event.summary %}<p class="st__body">{{ event.summary }}</p>{% endif %}
            {% if event.address %}
              {% if event.map %}
                <a class="loc__address" href="{{ event.map }}" target="_blank" rel="noopener noreferrer">
                  {{ event.address }}
                  <svg class="ext" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M14 4h6v6"/>
                    <path d="M20 4 11 13"/>
                    <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
                  </svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              {% else %}
                <span class="loc__address">{{ event.address }}</span>
              {% endif %}
            {% endif %}

            {# Optional venue logo. The white chip is what keeps a dark logo
               readable on the green, so the box is doing real work here.
               Rendered as an <img> and never inlined, because these files
               arrive by pull request. #}
            {% if event.logo and event.logo.src %}
              <div class="loc__host">
                <span class="loc__host-lab">Hosted at</span>
                {% if event.logo.url %}
                  <a class="loc__logo" href="{{ event.logo.url }}" target="_blank" rel="noopener noreferrer">
                    <img src="{{ event.logo.src }}" alt="{{ event.logo.alt or event.venue }}" loading="lazy" decoding="async">
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                {% else %}
                  <span class="loc__logo">
                    <img src="{{ event.logo.src }}" alt="{{ event.logo.alt or event.venue }}" loading="lazy" decoding="async">
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
          <div class="loc__when">
            <div class="loc__when-row">
              <span class="loc__when-lab">Date:</span>
              <span class="d">{{ site.dateShort }}</span>
            </div>
            {% if event.time %}
              <div class="loc__when-row">
                <span class="loc__when-lab">Time:</span>
                <span class="t">{{ event.time }}</span>
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      {% if event.activities and event.activities | length %}
        <span class="loc__note">What's on at this one</span>
        <div class="grid grid--acts">
          {% for item in event.activities %}
            <div class="st st--peel {{ angles[loop.index0 % 5] }}">
              <h3>{{ item.title }}</h3>
              {# Descriptions may carry light formatting such as <strong>, so
                 they are not escaped. Entries arrive by reviewed pull request. #}
              {% if item.description %}<p class="st__body">{{ item.description | safe }}</p>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if event.actions and event.actions | length %}
        <div class="grid">
          <div class="st st--yellow st--peel a4 col-12">
            <span class="lab">Take part at {{ event.venue }}</span>
            <div class="acts" style="margin-top:4px">
              {% for action in event.actions %}
                {# A link that is not ready yet renders as an inert span rather
                   than an anchor to "#", so it cannot be clicked or focused and
                   plainly reads as not available. #}
                {% if action.url and action.url != "#" %}
                  <a class="btn btn--{{ action.style or 'outline' }}" href="{{ action.url }}">{{ action.label }}</a>
                {% else %}
                  <span class="btn btn--off" aria-disabled="true">
                    {{ action.label }}
                    <span class="btn__soon">Coming soon</span>
                  </span>
                {% endif %}
              {% endfor %}

              {# Generated from the volunteer flag rather than listed in
                 actions, so a host opts in with one line and the link is
                 always right. Sits after the listed actions so registering
                 stays the first thing offered. #}
              {% if event.volunteer and event.volunteer.open %}
                <a class="btn btn--green" href="/volunteer/?location={{ event.id }}">Volunteer on the day</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </section>
  {% endfor %}

  {# ---- The always-open slot ---- #}
  <section class="loc loc--open" id="add-a-location">
    <span class="loc__tab">
      Location {% set next = events | length + 1 %}{% if next < 10 %}0{% endif %}{{ next }} &middot; Unclaimed
    </span>

    <div class="grid">
      <div class="st st--blank a3 col-12 loc__head">
        <div>
          <span class="lab">No host yet</span>
          <h2>Your town</h2>
          <p class="st__body">Every sticker on this sheet started as somebody offering to run one.</p>
        </div>
        <div class="loc__when">
          <div class="loc__when-row">
            <span class="loc__when-lab">Date:</span>
            <span class="d">{{ site.dateShort }}</span>
          </div>
          <div class="loc__when-row">
            <span class="loc__when-lab">Time:</span>
            <span class="t">Set by host</span>
          </div>
        </div>
      </div>
    </div>

    <span class="loc__note">Whoever hosts picks what's on</span>

    <div class="grid">
      <div class="st st--blank a2 col-6">
        <h3>It can be small</h3>
        <p class="st__body">Six people and a kettle is a legitimate catch-up. An install fest, a chat, a film night, or just coffee. You decide what your one looks like.</p>
        <div class="acts">
          <a class="btn btn--green" href="{{ site.submitLocation.url }}">{{ site.submitLocation.linkText }}</a>
        </div>
      </div>

      <div class="st st--orange st--peel a4 col-6">
        <span class="lab">{{ site.organise.label }}</span>
        <h3>{{ site.organise.heading }}</h3>
        <p class="st__body">{{ site.organise.body }}</p>
        <div class="acts">
          <a class="btn btn--outline" href="{{ site.organise.url }}">{{ site.organise.linkText }}</a>
        </div>
      </div>
    </div>
  </section>

  {# ===================== WORLDWIDE ===================== #}
  <div class="grid">
    <div class="st st--dark st--peel a2 col-12">
      <span class="lab">{{ site.worldwide.label }}</span>
      <h2>{{ site.worldwide.heading }}</h2>
      <p class="st__body" style="max-width:60ch">{{ site.worldwide.body }}</p>
      <div class="acts">
        <a class="btn btn--primary btn--ext"
           href="{{ site.worldwide.url }}"
           target="_blank" rel="noopener noreferrer">
          {{ site.worldwide.linkText }}
          <svg class="ext" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14 4h6v6"/>
            <path d="M20 4 11 13"/>
            <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
          </svg>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </div>
  </div>

</div>

{# Floats over the page rather than sitting in the layout, so it stays put
   while everything scrolls under it. Held back a couple of seconds by an
   animation delay rather than a script, so it behaves the same with
   JavaScript switched off, and it is a real link as well as a hint. #}
<a class="cue" href="#events">
  <span>Scroll to see events</span>
  <svg class="cue__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 5v14"/>
    <path d="m5 12 7 7 7-7"/>
  </svg>
</a>

<script>
  // Progressive enhancement, like the menu in the layout: with no JavaScript
  // the cue simply stays, which is the behaviour it had before this ran.
  (function () {
    var cue = document.querySelector(".cue");
    if (!cue) return;

    var gone = null;

    function update() {
      // Anything past a nudge counts as having started scrolling.
      var past = window.scrollY > 60;
      if (past === gone) return;
      gone = past;
      cue.classList.toggle("cue--gone", past);
      // Keep it out of the tab order and off screen readers while hidden,
      // so it is gone in the same way for everybody.
      cue.setAttribute("aria-hidden", String(past));
      cue.setAttribute("tabindex", past ? "-1" : "0");
    }

    addEventListener("scroll", update, { passive: true });
    // A reload can restore a scroll position part way down the page.
    update();
  })();
</script>
